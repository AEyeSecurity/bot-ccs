        "jsCode": "function sanitize(body) {\n  const clean = {};\n  for (const [key, value] of Object.entries(body || {})) {\n    if (/^MediaUrl\\d+$/i.test(key) || /^MediaUrl$/i.test(key)) continue;\n    clean[key] = value;\n  }\n  return clean;\n}\n\nconst webhook = $input.first().json || {};\nconst body = webhook.body || webhook || {};\nconst rawBody = String(body.Body || '').trim();\nconst buttonPayload = String(body.ButtonPayload || '').trim();\nconst buttonText = String(body.ButtonText || '').trim();\nconst listId = String(body.ListId || body.ListID || '').trim();\nconst listTitle = String(body.ListTitle || '').trim();\nconst bodyForIntent = String(buttonPayload || buttonText || listId || listTitle || rawBody || '').trim();\nconst numMedia = parseInt(String(body.NumMedia || 0), 10) || 0;\nconst mediaContentTypes = [];\nconst mediaUrls = [];\nfor (let i = 0; i < numMedia; i++) {\n  if (body[`MediaContentType${i}`]) mediaContentTypes.push(String(body[`MediaContentType${i}`]));\n  if (body[`MediaUrl${i}`]) mediaUrls.push(String(body[`MediaUrl${i}`]));\n}\n\nreturn [{\n  json: {\n    from: String(body.From || ''),\n    to: String(body.To || ''),\n    body: bodyForIntent,\n    messageSid: String(body.MessageSid || body.SmsMessageSid || body.SmsSid || '').trim() || null,\n    profileName: String(body.ProfileName || '').trim() || null,\n    numMedia,\n    mediaContentTypes,\n    mediaUrls,\n    rawPayload: sanitize(body)\n  }\n}];"
      },
