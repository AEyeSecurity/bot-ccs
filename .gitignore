# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent and generated runtime state
/.agents/
/.codex/
/.codex-spreadsheets-runtime/

# operational output and potentially sensitive evidence
/logs/
/test-reports/
/backups/
/cloudflare-backups/

# generated inspection artifacts
/data/*.inspect.ndjson

# n8n verification/import snapshots; keep only the canonical workflow
/n8n/*.check.json
/n8n/*.verify.json
/n8n/*.import.json

# accidental local scratch file
/-
